{
  "name": "swing-screener",
  "version": "1.0.0",
  "description": "Automated swing trading stock screener with real-time tracking, technical analysis, notification, and Google Sheets integration.",
  "main": "main.ts",
  "scripts": {
    "start": "ts-node main.ts",
    "start:prod": "node dist/main.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node main.ts",
    "build": "tsc",
    "build:client": "cd client && npm install && npm run build",
    "build:all": "npm run build && npm run build:client",
    "dev:client": "cd client && npm run dev",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:client\"",
    "db:setup": "psql -d stock_analysis -f database/schema.sql",
    "db:migrate": "psql -d stock_analysis -f database/schema.sql",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.8",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "googleapis": "^133.0.0",
    "groq-sdk": "^0.37.0",
    "helmet": "^7.2.0",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.9.11",
    "pg": "^8.16.3",
    "puppeteer": "^21.11.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "stock-nse-india": "^1.3.0",
    "technicalindicators": "^3.1.0",
    "yahoo-finance2": "^2.5.10"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.0",
    "@types/helmet": "^0.0.48",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.0",
    "@types/pg": "^8.10.0",
    "@vitest/coverage-v8": "^4.1.1",
    "concurrently": "^8.2.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "nodemon": "^3.0.3",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.1"
  }
}
